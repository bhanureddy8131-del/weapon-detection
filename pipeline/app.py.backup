elif page == "Detection Controls":
    st.markdown("### Detection controls")

    st.caption(
        "These settings control dashboard filtering. Model thresholds are "
        "passed to process_frame only if its signature supports them."
    )

    st.slider(
        "Minimum confidence for incident records",
        min_value=0.0,
        max_value=1.0,
        value=0.35,
        step=0.05,
        key="confidence",
    )

    st.multiselect(
        "Classes to include in incident history",
        options=["Gun / firearm", "Knife", "Other objects"],
        default=["Gun / firearm", "Knife"],
        key="selected_classes",
    )

    st.toggle(
        "Enable alert notifications in the dashboard",
        key="alerts_enabled",
    )

    st.toggle(
        "Enable monitoring interface",
        key="monitoring_enabled",
    )

    st.divider()
    st.markdown("#### Model status")

    if st.session_state.model_bundle is not None:
        st.success("The model loader returned successfully.")
        st.write("Device:", str(st.session_state.model_bundle[2]))
        st.write(
            "LSTM model available:",
            st.session_state.model_bundle[1] is not None,
        )
    elif st.session_state.model_load_error:
        st.error(st.session_state.model_load_error)
    else:
        st.info("Models have not been loaded.")

    if st.button("Initialize models now", type="primary"):
        st.session_state.model_bundle = None
        st.session_state.model_load_error = None
        result = load_existing_models()

        if result is None:
            st.error(
                st.session_state.model_load_error
                or "Model loading did not succeed."
            )
        else:
            st.success("Model loader completed.")
            st.rerun()


# ---------------------------------------------------------
# Alerts
# ---------------------------------------------------------

elif page == "Alerts":
    st.markdown("### Security alerts")

    if not st.session_state.alerts_enabled:
        st.warning("Dashboard alert notifications are disabled.")
    else:
        st.caption(
            "This page shows session records requiring review. It does not "
            "send SMS, email, or external notifications."
        )

        incidents = st.session_state.incidents
        urgent = [
            item for item in incidents
            if item["Severity"] == "High"
        ]
        review = [
            item for item in incidents
            if item["Severity"] == "Review"
        ]

        a, b = st.columns(2)
        a.metric("High-priority records", len(urgent))
        b.metric("Review records", len(review))

        if urgent:
            st.markdown("#### High-priority records")
            st.dataframe(
                pd.DataFrame(urgent[::-1]),
                use_container_width=True,
                hide_index=True,
            )
        else:
            st.success("No high-priority records have been recorded.")

        if review:
            st.markdown("#### Items to review")
            st.dataframe(
                pd.DataFrame(review[::-1]),
                use_container_width=True,
                hide_index=True,
            )

        st.download_button(
            "Export all alerts",
            data=pd.DataFrame(incidents).to_csv(index=False).encode("utf-8")
            if incidents else b"Time,Class,Confidence,Severity,Source\n",
            file_name="smartvision_alerts.csv",
            mime="text/csv",
        )


# ---------------------------------------------------------
# Footer
# ---------------------------------------------------------

st.divider()
st.caption(
    "SmartVision Pro · Local dashboard · "
    f"Last refreshed {datetime.now().strftime('%H:%M:%S')} · "
    "Detection results require human verification."
)
