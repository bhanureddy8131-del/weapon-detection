# ---------------------------------------------------------
# Overview
# ---------------------------------------------------------

if page == "Overview":
    incidents = st.session_state.incidents
    high_count = sum(x["Severity"] == "High" for x in incidents)
    review_count = sum(x["Severity"] == "Review" for x in incidents)

    cols = st.columns(4)
    metrics = [
        ("INCIDENT RECORDS", len(incidents), "Current session"),
        ("HIGH-PRIORITY", high_count, "Requires review"),
        ("REVIEW ITEMS", review_count, "Inspect detections"),
        ("FRAMES PROCESSED", st.session_state.processed_frames, "This session"),
    ]

    for col, (label, value, note) in zip(cols, metrics):
        with col:
            st.markdown(
                f"""
                <div class="metric-card">
                    <div class="metric-label">{label}</div>
                    <div class="metric-value">{value:,}</div>
                    <div class="metric-note">{note}</div>
                </div>
                """,
                unsafe_allow_html=True,
            )

    st.write("")
    left, right = st.columns([1.55, 1])

    with left:
        st.markdown("### Recent incident activity")
        if incidents:
            st.dataframe(
                pd.DataFrame(incidents[-10:][::-1]),
                use_container_width=True,
                hide_index=True,
            )
        else:
            st.info(
                "No incidents recorded in this session. "
                "Upload a video or analyze a camera frame to begin."
            )

    with right:
        st.markdown("### Detection distribution")
        if incidents:
            counts = Counter(item["Class"] for item in incidents)
            st.bar_chart(pd.Series(counts, name="Events"))
        else:
            st.info("Charts appear after detections are recorded.")

    st.markdown("### Quick actions")
    a, b, c = st.columns(3)
    with a:
        if st.button("Open live monitoring", use_container_width=True):
            st.session_state["requested_page"] = "Live Monitoring"
            st.info("Select Live Monitoring from the sidebar.")
    with b:
        if st.button("Analyze a video", use_container_width=True):
            st.info("Select Video Upload from the sidebar.")
    with c:
        if st.button("Review incidents", use_container_width=True):
            st.info("Select Incident History from the sidebar.")


# ---------------------------------------------------------
# Live monitoring
# ---------------------------------------------------------

elif page == "Live Monitoring":
    st.markdown("### Live camera monitoring")
    st.caption(
        "Capture a frame from your camera and run it through the existing "
        "inference pipeline. This is frame-based monitoring, not a continuous "
        "browser video stream."
    )

    source = st.selectbox(
        "Camera source",
        ["Browser camera capture", "Upload a frame"],
    )

    camera_image = None

    if source == "Browser camera capture":
        camera_image = st.camera_input("Capture a camera frame")
    else:
        camera_image = st.file_uploader(
            "Upload an image frame",
            type=["jpg", "jpeg", "png"],
            key="live_image",
        )

    if camera_image is not None:
        raw_bytes = np.frombuffer(camera_image.getvalue(), dtype=np.uint8)
        frame = cv2.imdecode(raw_bytes, cv2.IMREAD_COLOR)

        if frame is None:
            st.error("The selected image could not be decoded.")
        else:
            st.markdown("#### Captured frame")
            render_frame(frame)

            if st.button("Analyze frame", type="primary"):
                with st.spinner("Running the existing inference pipeline..."):
                    result_frame, detections, error = run_existing_inference(
                        frame
                    )
                    st.session_state.processed_frames += 1
                    st.session_state.last_source = "Camera"
                    st.session_state.last_frame = result_frame

                    if error:
                        st.error(f"Inference could not complete: {error}")
                    else:
                        add_incidents(detections, "Camera")
                        st.success("Inference function completed.")

                    st.markdown("#### Analysis result")
                    render_frame(result_frame)

                    st.metric("Returned detections", len(detections))

                    if detections:
                        st.dataframe(
                            pd.DataFrame([
                                {
                                    "Class": detection_label(item),
                                    "Confidence": detection_confidence(item),
                                }
                                for item in detections
                            ]),
                            use_container_width=True,
                            hide_index=True,
                        )
                    elif not error:
                        st.info(
                            "The inference function returned no structured "
                            "detections. This does not prove that the scene "
                            "contains no threat."
                        )

    if st.session_state.model_load_error:
        st.warning(
            "Model initialization error: "
            + st.session_state.model_load_error
        )


# ---------------------------------------------------------
# Video upload
# ---------------------------------------------------------

elif page == "Video Upload":
    st.markdown("### Video analysis")
    st.caption(
        "Upload a video to sample frames and pass them to your existing "
        "inference pipeline."
    )

    uploaded_video = st.file_uploader(
        "Choose a video",
        type=["mp4", "avi", "mov", "mkv"],
    )

    sample_every = st.slider(
        "Analyze every Nth frame",
        min_value=1,
        max_value=60,
        value=10,
        help="Higher values process fewer frames and run faster.",
    )

    max_frames = st.slider(
        "Maximum frames to analyze",
        min_value=10,
        max_value=500,
        value=100,
        step=10,
    )

    if uploaded_video is not None:
        st.video(uploaded_video)

        if st.button("Start video analysis", type="primary"):
            temp_path = None
            cap = None

            try:
                import tempfile

                suffix = Path(uploaded_video.name).suffix or ".mp4"
                with tempfile.NamedTemporaryFile(
                    delete=False, suffix=suffix
                ) as temp_file:
                    temp_file.write(uploaded_video.getvalue())
                    temp_path = temp_file.name

                cap = cv2.VideoCapture(temp_path)

                if not cap.isOpened():
                    st.error("Could not open this video file.")
                else:
                    total_frames = int(
                        cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0
                    )
                    fps = cap.get(cv2.CAP_PROP_FPS)
                    if not fps or fps <= 0:
                        fps = 25.0

                    st.write(
                        f"Video length: {total_frames} frames · "
                        f"{fps:.1f} FPS"
                    )

                    progress = st.progress(0)
                    status = st.empty()
                    preview = st.empty()
                    analyzed = 0
                    frame_index = 0

                    while analyzed < max_frames:
                        ok, frame = cap.read()
                        if not ok:
                            break

                        if frame_index % sample_every == 0:
                            result_frame, detections, error = (
                                run_existing_inference(frame)
                            )

                            analyzed += 1
                            st.session_state.processed_frames += 1
                            st.session_state.last_source = uploaded_video.name

                            if error:
                                status.error(
                                    "Inference error: " + error
                                )
                                break

                            add_incidents(detections, uploaded_video.name)

                            preview.image(
                                cv2.cvtColor(
                                    result_frame, cv2.COLOR_BGR2RGB
                                ),
                                caption=f"Analyzed frame {frame_index}",
                                use_container_width=True,
                            )

                            if total_frames > 0:
                                progress.progress(
                                    min(frame_index / total_frames, 1.0)
                                )

                            status.write(
                                f"Analyzed {analyzed} frame(s) · "
                                f"Detections returned: {len(detections)}"
                            )

                        frame_index += 1

                    progress.progress(1.0)
                    status.success(
                        f"Finished. Analyzed {analyzed} sampled frames."
                    )

            except Exception as exc:
                logger.exception("Video analysis failed.")
                st.error(f"Video analysis failed: {exc}")

            finally:
                if cap is not None:
                    cap.release()

                if temp_path and os.path.exists(temp_path):
                    try:
                        os.remove(temp_path)
                    except OSError:
                        pass


# ---------------------------------------------------------
# Incident history
# ---------------------------------------------------------

elif page == "Incident History":
    st.markdown("### Incident history")
    st.caption("Records generated during the current Streamlit session.")

    incidents = st.session_state.incidents

    if not incidents:
        st.info("No incident records yet. Analyze a frame or upload a video.")
    else:
        history_df = pd.DataFrame(incidents)

        search = st.text_input("Search class or source")
        severity_filter = st.multiselect(
            "Severity",
            options=sorted(history_df["Severity"].dropna().unique()),
            default=sorted(history_df["Severity"].dropna().unique()),
        )

        filtered = history_df[
            history_df["Severity"].isin(severity_filter)
        ]

        if search.strip():
            mask = (
                filtered["Class"].astype(str).str.contains(
                    search, case=False, na=False
                )
                | filtered["Source"].astype(str).str.contains(
                    search, case=False, na=False
                )
            )
            filtered = filtered[mask]

        st.dataframe(
            filtered.iloc[::-1],
            use_container_width=True,
            hide_index=True,
        )

        st.download_button(
            "Export incident history as CSV",
            data=filtered.to_csv(index=False).encode("utf-8"),
            file_name="smartvision_incident_history.csv",
            mime="text/csv",
            use_container_width=True,
        )

        if st.button("Clear session incident history"):
            st.session_state.incidents = []
            st.rerun()


