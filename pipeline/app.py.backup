DEFAULTS = {
    "incidents": [],
    "model_bundle": None,
    "model_load_error": None,
    "processed_frames": 0,
    "last_frame": None,
    "last_source": "None",
    "alerts_enabled": True,
    "monitoring_enabled": True,
}

for key, value in DEFAULTS.items():
    if key not in st.session_state:
        st.session_state[key] = value


# ---------------------------------------------------------
# Existing inference integration
# ---------------------------------------------------------

def load_existing_models():
    """Load models using the project's existing inference function."""
    if st.session_state.model_bundle is not None:
        return st.session_state.model_bundle

    try:
        from pipeline.run_inference import load_models

        bundle = load_models()

        if not isinstance(bundle, (tuple, list)):
            raise RuntimeError("load_models() returned an unexpected result.")

        if len(bundle) < 5:
            raise RuntimeError(
                "Expected five values from load_models(): "
                "detector, LSTM model, device, class map, threat manager."
            )

        st.session_state.model_bundle = tuple(bundle[:5])
        st.session_state.model_load_error = None
        return st.session_state.model_bundle

    except Exception as exc:
        logger.exception("Could not load the existing inference models.")
        st.session_state.model_load_error = str(exc)
        return None


def run_existing_inference(frame: np.ndarray):
    """
    Call the existing process_frame() function without replacing it.

    Parameter names are inspected to support common function signatures.
    If the existing function requires a different signature, the dashboard
    displays the error instead of silently claiming that detection succeeded.
    """
    bundle = load_existing_models()

    if bundle is None:
        return frame.copy(), [], "Models are not available."

    detector, lstm_model, device, inv_class_map, threat_manager = bundle

    try:
        from pipeline.run_inference import process_frame

        signature = inspect.signature(process_frame)

        values = {
            "frame": frame,
            "image": frame,
            "img": frame,
            "image_frame": frame,
            "frame_bgr": frame,
            "detector": detector,
            "yolo_detector": detector,
            "model": detector,
            "yolo_model": detector,
            "lstm_model": lstm_model,
            "lstm": lstm_model,
            "action_model": lstm_model,
            "device": device,
            "inv_class_map": inv_class_map,
            "class_map": inv_class_map,
            "class_names": inv_class_map,
            "threat_manager": threat_manager,
            "confidence": st.session_state.get("confidence", 0.35),
            "conf_threshold": st.session_state.get("confidence", 0.35),
            "conf": st.session_state.get("confidence", 0.35),
        }

        args = []
        kwargs = {}

        # Map known names to their corresponding values.
        # Use positional arguments if the existing function uses them.
        fallback = [
            frame,
            detector,
            lstm_model,
            device,
            inv_class_map,
            threat_manager,
        ]
        fallback_index = 0

        for name, parameter in signature.parameters.items():
            if parameter.kind == inspect.Parameter.VAR_POSITIONAL:
                continue

            if parameter.kind == inspect.Parameter.VAR_KEYWORD:
                continue

            if name in values:
                value = values[name]
            elif parameter.default is not inspect.Parameter.empty:
                continue
            else:
                if fallback_index >= len(fallback):
                    raise RuntimeError(
                        "Cannot map required process_frame parameter: "
                        + name
                    )
                value = fallback[fallback_index]
                fallback_index += 1

            if parameter.kind == inspect.Parameter.POSITIONAL_ONLY:
                args.append(value)
            else:
                kwargs[name] = value

        result = process_frame(*args, **kwargs)

        output_frame = frame.copy()
        detections = []

        if isinstance(result, np.ndarray):
            output_frame = result

        elif isinstance(result, dict):
            possible_frame = (
                result.get("frame")
                if isinstance(result.get("frame"), np.ndarray)
                else result.get("annotated_frame")
            )

            if isinstance(possible_frame, np.ndarray):
                output_frame = possible_frame

            possible_detections = result.get(
                "detections", result.get("objects", [])
            )
            if isinstance(possible_detections, (list, tuple)):
                detections = list(possible_detections)

        elif isinstance(result, (tuple, list)):
            for item in result:
                if isinstance(item, np.ndarray) and item.ndim >= 2:
                    output_frame = item
                    break

            for item in result:
                if isinstance(item, (list, tuple)) and item:
                    first = item[0]
                    if isinstance(first, dict):
                        detections = list(item)
                        break

                if isinstance(item, dict) and (
                    "class" in item
                    or "label" in item
                    or "class_name" in item
                ):
                    detections.append(item)

        return output_frame, detections, None

    except Exception as exc:
        logger.exception("Inference failed.")
        return frame.copy(), [], str(exc)


# ---------------------------------------------------------
# Incident tracking and detection display
# ---------------------------------------------------------

WEAPON_TERMS = (
    "gun",
    "firearm",
    "pistol",
    "rifle",
    "handgun",
    "knife",
    "weapon",
)

def detection_label(item):
    if isinstance(item, dict):
        return str(
            item.get(
                "class_name",
                item.get("label", item.get("class", "Unknown")),
            )
        )

    if isinstance(item, (tuple, list)) and item:
        return str(item[0])

    return str(item)


def detection_confidence(item):
    if isinstance(item, dict):
        for key in ("confidence", "conf", "score"):
            value = item.get(key)
            if isinstance(value, (int, float)):
                return float(value)

    if isinstance(item, (tuple, list)) and len(item) > 1:
        if isinstance(item[1], (int, float)):
            return float(item[1])

    return None


def add_incidents(detections, source):
    """Save visible detections to the session history."""
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    threshold = float(st.session_state.get("confidence", 0.35))
    selected_classes = st.session_state.get(
        "selected_classes", ["Gun / firearm", "Knife"]
    )

    aliases = {
        "Gun / firearm": ("gun", "firearm", "pistol", "rifle", "handgun"),
        "Knife": ("knife",),
        "Other objects": (),
    }

    for item in detections:
        label = detection_label(item)
        conf = detection_confidence(item)
        lowered = label.lower()

        if conf is not None and conf < threshold:
            continue

        matches = [
            choice for choice in selected_classes
            if choice == "Other objects"
            or any(term in lowered for term in aliases.get(choice, ()))
        ]

        # Do not invent a weapon label for an unknown object.
        if not matches:
            continue

        if any(term in lowered for term in WEAPON_TERMS):
            severity = "High"
        else:
            severity = "Review"

        record = {
            "Time": now,
            "Class": label,
            "Confidence": round(conf, 3) if conf is not None else None,
            "Severity": severity,
            "Source": source,
        }

        st.session_state.incidents.append(record)

    # Keep the latest 1,000 records in memory.
    st.session_state.incidents = st.session_state.incidents[-1000:]


def render_frame(frame):
    if frame is None:
        return

    if len(frame.shape) == 3:
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    else:
        frame_rgb = frame

    st.image(frame_rgb, use_container_width=True)


